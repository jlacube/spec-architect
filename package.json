{
  "name": "architect-plugin",
  "version": "0.0.3",
  "private": true,
  "description": "Architect: a Claude Code agent suite for spec-driven development",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/build.mjs && node scripts/test.mjs",
    "check": "node scripts/check.mjs",
    "replay": "node tests/replay/run.mjs",
    "bench": "node scripts/build.mjs && node bench/run.mjs",
    "eval": "node evals/harness/run.mjs",
    "eval:report": "node evals/harness/report.mjs",
    "package": "node scripts/package.mjs",
    "smoke:npm": "node scripts/smoke-npm.mjs",
    "generate": "node scripts/generate.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@opencode-ai/sdk": "1.18.31",
    "@types/node": "^20.19.43",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  }
}
