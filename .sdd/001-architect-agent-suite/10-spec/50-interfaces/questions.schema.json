{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architect.local/schemas/questions.schema.json",
  "title": "C001-IF-05 Interview questions block",
  "description": "Returned by specialists in a fenced ```json block named 'questions'; logged by the conductor in questions-log.md with the answer.",
  "type": "object",
  "required": ["questions"],
  "additionalProperties": false,
  "properties": {
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "topic", "question", "why_it_matters", "blocking", "material"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^Q-[a-z]+-[0-9]{2,3}$" },
          "topic": { "type": "string", "minLength": 1 },
          "question": { "type": "string", "minLength": 5 },
          "why_it_matters": { "type": "string", "minLength": 5 },
          "blocking": { "type": "boolean" },
          "material": { "type": "boolean", "description": "true when it changes scope, architecture, an interface, an NFR threshold or a dependency (C001-REQ-207)" },
          "candidates_considered": { "type": "integer", "minimum": 0, "maximum": 5 },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": {
              "type": "object",
              "required": ["label", "rationale"],
              "additionalProperties": false,
              "properties": {
                "label": { "type": "string", "minLength": 1 },
                "rationale": { "type": "string", "minLength": 1 },
                "score": { "type": "number", "minimum": 1, "maximum": 5 },
                "recommended": { "type": "boolean" }
              }
            }
          },
          "rejected": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "reason"],
              "additionalProperties": false,
              "properties": {
                "label": { "type": "string" },
                "reason": { "type": "string" }
              }
            }
          },
          "source_refs": { "type": "array", "items": { "type": "string" } },
          "answer": { "type": ["string", "null"], "description": "verbatim answer, filled by the conductor" },
          "extracted_instructions": { "type": "array", "items": { "type": "string" } }
        },
        "allOf": [
          {
            "if": { "properties": { "material": { "const": true } } },
            "then": { "required": ["candidates_considered", "options", "rejected"], "properties": { "candidates_considered": { "minimum": 4 } } }
          }
        ]
      }
    }
  }
}
