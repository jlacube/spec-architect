{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architect.local/schemas/lint-report.schema.json",
  "title": "C001-IF-11 §1 Lint report",
  "type": "object",
  "required": ["tool", "scope", "summary", "findings"],
  "additionalProperties": false,
  "properties": {
    "tool": { "type": "string", "pattern": "^architect-plugin@[0-9]+\\.[0-9]+\\.[0-9]+" },
    "scope": {
      "type": "object",
      "required": ["changes", "phase", "quick"],
      "additionalProperties": false,
      "properties": {
        "changes": { "type": "array", "items": { "type": "string", "pattern": "^CHG-[0-9]{3}$" } },
        "phase": { "type": ["string", "null"], "enum": ["00-ideation", "10-spec", "20-plan", null] },
        "quick": { "type": "boolean" },
        "file": { "type": "string" }
      }
    },
    "summary": {
      "type": "object",
      "required": ["error", "warn", "info"],
      "additionalProperties": false,
      "properties": {
        "error": { "type": "integer", "minimum": 0 },
        "warn": { "type": "integer", "minimum": 0 },
        "info": { "type": "integer", "minimum": 0 }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "path", "message", "fix"],
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string", "pattern": "^(LINT-[A-Z]+-[0-9]{3}|TR-[0-9]{2})$" },
          "severity": { "enum": ["error", "warn", "info"] },
          "path": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "ids": { "type": "array", "items": { "type": "string" } },
          "message": { "type": "string", "minLength": 1 },
          "fix": { "type": "string", "minLength": 1 }
        }
      }
    },
    "coverage": {
      "type": "object",
      "patternProperties": {
        "^TR-[0-9]{2}$": {
          "type": "object",
          "required": ["covered", "total"],
          "properties": { "covered": { "type": "integer", "minimum": 0 }, "total": { "type": "integer", "minimum": 0 } }
        }
      },
      "additionalProperties": false
    }
  }
}
