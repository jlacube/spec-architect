#!/bin/sh
# Host shim (D-047): VS Code with GitHub Copilot Chat built in (no entry in --list-extensions).
case "$1" in
  --version) printf '1.145.2\nc4453f8ea430795f941c1b2ff6c9321135a74a02\nx64\n'; exit 0 ;;
