{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "snapshot": false,
  "enabled_providers": ["stub"],
  "model": "stub/stub-model",
  "small_model": "stub/stub-model",
  "provider": {
    "stub": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Replay loopback stub (C002-ADR-005)",
      "options": { "baseURL": "@STUB_BASE_URL@", "apiKey": "stub-no-key" },
      "models": { "stub-model": { "name": "stub-model", "tool_call": true, "limit": { "context": 100000, "output": 4000 } } }
    }
  }
}
