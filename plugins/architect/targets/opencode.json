{
  "$schema": "./mapping-table.schema.json",
  "schema_version": 1,
  "target": "opencode",
  "enforcement_mode": "sdd-mcp-server",
  "host": {
    "name": "OpenCode",
    "tested_versions": { "opencode": "1.18.31" },
    "validated_by": "docs/spikes/S-07-opencode.md"
  },
  "placement": {
    "agents_dir": ".opencode/agents",
    "agent_file": "{name}.md",
    "commands_dir": ".opencode/commands",
    "command_file": "architect-{name}.md",
    "skills_dir": ".opencode/skills",
    "config_file": "opencode.json",
    "hooks_file": null,
    "plugin_manifest": null,
    "cli_copy": null,
    "manifest_file": "architect-target.json",
    "install_notes": "INSTALL.md"
  },
  "models": {
    "opus": "openrouter/anthropic/claude-opus-5.5",
    "sonnet": "openrouter/anthropic/claude-sonnet-5.5",
    "haiku": "openrouter/anthropic/claude-haiku-5.5"
  },
  "agent_fields": {
    "effort": "drop",
    "color": "drop",
    "memory": "drop",
    "skills": "inline",
    "subagent_flags": { "mode": "subagent" },
    "primary_flags": { "mode": "primary" }
  },
  "tools": {
    "Read": ["read"],
    "Glob": ["glob"],
    "Grep": ["grep"],
    "Write": { "by_mode": { "native-permissions": ["write"], "sdd-mcp-server": ["sdd-files_write_file"] } },
    "Edit": { "by_mode": { "native-permissions": ["edit"], "sdd-mcp-server": ["sdd-files_replace_text"] } },
    "Bash": { "by_mode": { "native-permissions": ["bash"], "sdd-mcp-server": ["sdd-shell_run_command"] } },
    "WebSearch": ["websearch"],
    "WebFetch": ["webfetch"],
    "LSP": ["lsp"],
    "ToolSearch": [],
    "AskUserQuestion": ["question"],
    "TaskCreate": ["todowrite"],
    "TaskUpdate": ["todowrite"],
    "TaskList": ["todowrite"],
    "Skill": ["skill"]
  },
  "agent_start": { "style": "permission-task", "tools": ["task"] },
  "mcp_tool_names": {
    "source_pattern": "mcp__plugin_architect_{server}__{tool}",
    "target_pattern": "{server}_{tool}",
    "grant": "per-tool",
    "deferred": false
  },
  "mcp_servers": {
    "context7": { "transport": "http", "url": "https://mcp.context7.com/mcp", "modes": ["native-permissions", "sdd-mcp-server"] },
    "deepwiki": { "transport": "http", "url": "https://mcp.deepwiki.com/mcp", "modes": ["native-permissions", "sdd-mcp-server"] },
    "serena": {
      "transport": "stdio",
      "command": "sdd",
      "args": [
        "serena-launch", "--user-data", "--read-only", "--", "start-mcp-server",
        "--context", "ide", "--mode", "planning", "--project", ".",
        "--enable-web-dashboard", "False", "--open-web-dashboard", "False"
      ],
      "modes": ["native-permissions", "sdd-mcp-server"]
    },
    "sdd-files": { "transport": "stdio", "command": "sdd-mcp", "args": ["--profile", "files"], "modes": ["sdd-mcp-server"] },
    "sdd-shell": { "transport": "stdio", "command": "sdd-mcp", "args": ["--profile", "shell"], "modes": ["sdd-mcp-server"] }
  },
  "variables": {
    "${CLAUDE_PLUGIN_ROOT}": { "body": null, "hook-command": null, "mcp-config": null },
    "${CLAUDE_PLUGIN_DATA}": { "body": "--user-data", "hook-command": null, "mcp-config": null },
    "$ARGUMENTS": { "body": "$ARGUMENTS", "hook-command": null, "mcp-config": null }
  },
  "references": {
    "agent": { "from": "architect:", "to": "" },
    "command": { "from": "/architect:", "to": "/architect-" }
  },
  "constructs": [
    { "id": "guard-line", "kind": "guard-line", "detect": "^This command runs in the `architect:sdd-conductor` main session\\.", "contexts": ["body"], "accepted_in": [], "action": { "drop_line": true } },
    { "id": "cli-invocation", "kind": "cli-invocation", "detect": "\\$\\{CLAUDE_PLUGIN_ROOT\\}/scripts/sdd\\.mjs", "contexts": ["body"], "accepted_in": [], "action": { "variant_required": true } },
    { "id": "claude-host", "kind": "other", "detect": "\\bclaude --version\\b", "contexts": ["body"], "accepted_in": [], "action": { "variant_required": true } },
    { "id": "plugin-root-templates", "kind": "plugin-root", "detect": "\\$\\{CLAUDE_PLUGIN_ROOT\\}/templates/", "contexts": ["body"], "accepted_in": [], "action": { "replace": "sdd template show " } },
    { "id": "plugin-root", "kind": "plugin-root", "detect": "\\$\\{CLAUDE_PLUGIN_ROOT\\}(?!/templates/|/scripts/sdd\\.mjs)", "contexts": ["frontmatter", "body", "hook-command", "mcp-config"], "accepted_in": [], "action": { "variant_required": true } },
    { "id": "plugin-data", "kind": "plugin-data", "detect": "\"?\\$\\{CLAUDE_PLUGIN_DATA\\}\"?", "contexts": ["body"], "accepted_in": [], "action": { "replace": "--user-data" } },
    { "id": "arguments", "kind": "arguments", "detect": "\\$ARGUMENTS\\b", "contexts": ["body"], "accepted_in": ["body"], "action": { "replace": "$ARGUMENTS" } },
    { "id": "command-reference", "kind": "command-reference", "detect": "/architect:(?=[a-z])", "contexts": ["frontmatter", "body"], "accepted_in": [], "action": { "replace": "/architect-" } },
    { "id": "conductor-start", "kind": "other", "detect": "\\(claude --agent (?:architect:)?sdd-conductor\\)", "contexts": ["frontmatter"], "accepted_in": [], "action": { "replace": "(select the `sdd-conductor` primary agent: press Tab until it is selected, or start `opencode --agent sdd-conductor`)" } },
    { "id": "doctor-description", "kind": "other", "detect": "\\(node, git, Claude Code, ripwire, Serena, ast-grep, Context7, DeepWiki\\)", "contexts": ["frontmatter"], "accepted_in": [], "action": { "replace": "(node, git, OpenCode, ripwire, Serena, ast-grep, Context7, DeepWiki, sdd CLI)" } },
    { "id": "agent-reference", "kind": "agent-reference", "detect": "\\barchitect:(?=sdd-)", "contexts": ["frontmatter", "body"], "accepted_in": [], "action": { "replace": "" } },
    { "id": "ask-user-question", "kind": "question-tool-name", "detect": "`?\\bAskUserQuestion\\b`?", "contexts": ["body"], "accepted_in": [], "action": { "replace": "the `question` tool" } },
    { "id": "task-tools", "kind": "task-tool-name", "detect": "`?\\bTask(?:Create|Update|List)\\b`?", "contexts": ["body"], "accepted_in": [], "action": { "replace": "the `todowrite` tool" } },
    { "id": "tool-search", "kind": "other", "detect": "`?\\bToolSearch\\b`?", "contexts": ["body"], "accepted_in": [], "action": { "replace": "(MCP tools are loaded at start)" } },
    { "id": "mcp-tool-name", "kind": "mcp-tool-name", "detect": "\\bmcp__plugin_architect_[a-z0-9]+__[A-Za-z0-9_-]+", "contexts": ["frontmatter", "body"], "accepted_in": [], "action": { "replace": "{server}_{tool}" } },
    { "id": "bash-prose", "kind": "tool-name", "detect": "\\bBash\\b", "contexts": ["body"], "accepted_in": [], "action": { "replace": { "by_mode": { "native-permissions": "the `bash` tool", "sdd-mcp-server": "the `sdd-shell` command tool" } } } }
  ],
  "variants": [
    {
      "id": "cli-conductor",
      "file": "agents/sdd-conductor.md",
      "anchor": {
        "lines": [
          "The CLI is `node \"${CLAUDE_PLUGIN_ROOT}/scripts/sdd.mjs\"` (written `sdd` below)."
        ]
      },
      "text_file": "cli-conductor.md"
    },
    {
      "id": "cli-auditor",
      "file": "agents/sdd-auditor.md",
      "anchor": {
        "lines": [
          "`;`, `|` or redirection; `sdd` is `node \"${CLAUDE_PLUGIN_ROOT}/scripts/sdd.mjs\"`):"
        ]
      },
      "text_file": "cli-auditor.md"
    },
    {
      "id": "doctor-probe",
      "file": "commands/doctor.md",
      "anchor": {
        "lines": [
          "2. **Probe.** Dispatch `sdd-cartographer` to write `.sdd/_constitution/toolchain.md` (code-discovery",
          "   skill, toolchain record): one row each for node, git, Claude Code, ripwire, Serena, ast-grep,",
          "   Context7, DeepWiki with detected, version, path or endpoint, fallback. Probes: `--version` for",
          "   the command-line tools (ripwire: `ripwire --version`, never `--doctor`); Context7 and DeepWiki:",
          "   load one of their tools and make one small call (unreachable when it fails). Without `.sdd/`,",
          "   probe the same way and skip the file."
        ]
      },
      "text_file": "doctor-probe.md"
    },
    {
      "id": "doctor-report",
      "file": "commands/doctor.md",
      "anchor": {
        "lines": [
          "3. **Report** a table with the columns Tool, Status, Version, Fallback, Fix — one row per tool in",
          "   the order above. Status: `ok`, `missing`, `unreachable` (remote servers) or `error` (present but",
          "   unusable or too old). Fix: for every non-ok row, the command of the remedies table below.",
          "   - node: `error` below version 20.",
          "   - Claude Code: `error` below 2.1.295 (`claude --version`).",
          "   - Fallbacks: ripwire → `serena → lsp → grep` (or the next available layer); Serena → `lsp → grep`;",
          "     ast-grep → `grep`; Context7 → `WebSearch/WebFetch`; DeepWiki → `WebFetch` of the repository.",
          "4. **Outcome** — the last line of your reply, exactly one of:",
          "   - `Doctor: failed: node ≥ 20 required` — node missing or older than 20;",
          "   - `Doctor: completed with warnings` — any other row not `ok`;",
          "   - `Doctor: completed` — every row `ok`."
        ]
      },
      "text_file": "doctor-report.md"
    },
    {
      "id": "doctor-remedies-host",
      "file": "commands/doctor.md",
      "anchor": {
        "lines": [
          "| Claude Code | `claude --version` ≥ 2.1.295 | `claude update`, or update the Claude desktop app (which bundles its own Claude Code) |"
        ]
      },
      "text_file": "doctor-remedies-host.md"
    },
    {
      "id": "doctor-remedies-task-tools",
      "file": "commands/doctor.md",
      "anchor": {
        "lines": [
          "| Task tools | `CLAUDE_CODE_ENABLE_TODO_TOOLS` is `1` | add `\"env\": { \"CLAUDE_CODE_ENABLE_TODO_TOOLS\": \"1\" }` to `~/.claude/settings.json` |"
        ]
      },
      "text_file": "doctor-remedies-task-tools.md"
    },
    {
      "id": "code-discovery-toolchain",
      "file": "skills/code-discovery/SKILL.md",
      "anchor": {
        "lines": [
          "- **Toolchain record** (`_constitution/toolchain.md`, init and doctor): a table with one row per",
          "  node, git, Claude Code, ripwire, Serena, ast-grep, Context7, DeepWiki — detected (yes/no),",
          "  version, path or endpoint, fallback in use (for ripwire absent: `serena → lsp → grep`, or the",
          "  next layer that is available). Probe with `--version`; Context7 and DeepWiki are detected when",
          "  their tools load."
        ]
      },
      "text_file": "code-discovery-toolchain.md"
    },
    {
      "id": "code-discovery",
      "file": "skills/code-discovery/SKILL.md",
      "anchor": {
        "section": "Claude Code wiring"
      },
      "text_file": "code-discovery.md"
    },
    {
      "id": "gate-protocol-reference",
      "file": "skills/gate-protocol/SKILL.md",
      "anchor": {
        "lines": [
          "The presentation goes into the gate question itself (see Claude Code wiring), so P-01 sees it"
        ]
      },
      "text_file": "gate-protocol-reference.md"
    },
    {
      "id": "gate-protocol",
      "file": "skills/gate-protocol/SKILL.md",
      "anchor": {
        "section": "Claude Code wiring"
      },
      "text_file": "gate-protocol.md"
    },
    {
      "id": "interview-protocol",
      "file": "skills/interview-protocol/SKILL.md",
      "anchor": {
        "section": "Claude Code wiring"
      },
      "text_file": "interview-protocol.md"
    },
    {
      "id": "research-protocol",
      "file": "skills/research-protocol/SKILL.md",
      "anchor": {
        "section": "Claude Code wiring"
      },
      "text_file": "research-protocol.md"
    },
    {
      "id": "cli-conventions",
      "file": "skills/sdd-conventions/SKILL.md",
      "anchor": {
        "lines": [
          "`sdd` means `node \"${CLAUDE_PLUGIN_ROOT}/scripts/sdd.mjs\"`. Useful commands: `sdd status`,"
        ]
      },
      "text_file": "cli-conventions.md"
    }
  ],
  "permissions": {
    "native-permissions": {
      "edit": [
        { "pattern": "*", "action": "deny" },
        { "pattern": ".sdd/*", "action": "allow" }
      ],
      "bash": [
        { "pattern": "*", "action": "deny" },
        { "pattern": "sdd *", "action": "allow" },
        { "pattern": "git log *", "action": "allow" },
        { "pattern": "git show *", "action": "allow" },
        { "pattern": "git diff *", "action": "allow" },
        { "pattern": "git blame *", "action": "allow" },
        { "pattern": "git ls-files *", "action": "allow" },
        { "pattern": "git rev-parse *", "action": "allow" },
        { "pattern": "git status *", "action": "allow" },
        { "pattern": "git grep *", "action": "allow" },
        { "pattern": "ripwire *--for=*", "action": "allow" },
        { "pattern": "ripwire *--pack-task=*", "action": "allow" },
        { "pattern": "ripwire *--callers=*", "action": "allow" },
        { "pattern": "ripwire *--uses=*", "action": "allow" },
        { "pattern": "ripwire *--impact=*", "action": "allow" },
        { "pattern": "ripwire *--expand=*", "action": "allow" },
        { "pattern": "ripwire *--test-gate*", "action": "allow" },
        { "pattern": "ripwire *--situ*", "action": "allow" },
        { "pattern": "ripwire *--hotspots*", "action": "allow" },
        { "pattern": "ripwire *--quality-panel*", "action": "allow" },
        { "pattern": "ripwire *--quality-delta*", "action": "allow" },
        { "pattern": "ripwire *--pack-signatures*", "action": "allow" },
        { "pattern": "ripwire *--doctor*", "action": "allow" },
        { "pattern": "ripwire *--help-task*", "action": "allow" },
        { "pattern": "ripwire *--version*", "action": "allow" },
        { "pattern": "ast-grep run *--pattern*", "action": "allow" },
        { "pattern": "node -v", "action": "allow" },
        { "pattern": "node --version", "action": "allow" },
        { "pattern": "git --version", "action": "allow" },
        { "pattern": "claude --version", "action": "allow" },
        { "pattern": "serena --version", "action": "allow" },
        { "pattern": "ast-grep --version", "action": "allow" },
        { "pattern": "uv --version", "action": "allow" },
        { "pattern": "head -n *", "action": "allow" },
        { "pattern": "tail -n *", "action": "allow" },
        { "pattern": "wc -l", "action": "allow" },
        { "pattern": "sort", "action": "allow" },
        { "pattern": "uniq", "action": "allow" },
        { "pattern": "git * -o *", "action": "deny" },
        { "pattern": "git * --output*", "action": "deny" },
        { "pattern": "git * -O*", "action": "deny" },
        { "pattern": "git * --open-files-in-pager*", "action": "deny" },
        { "pattern": "git * --ext-diff*", "action": "deny" },
        { "pattern": "ast-grep * --rewrite*", "action": "deny" },
        { "pattern": "ast-grep * -r *", "action": "deny" },
        { "pattern": "ast-grep * -U*", "action": "deny" },
        { "pattern": "ast-grep * --update-all*", "action": "deny" },
        { "pattern": "ast-grep * -i*", "action": "deny" },
        { "pattern": "sdd install *", "action": "deny" },
        { "pattern": "sdd serena-config *", "action": "deny" },
        { "pattern": "sdd serena-launch *", "action": "deny" },
        { "pattern": "sdd serena-config --user-data", "action": "allow" },
        { "pattern": "sdd serena-launch --user-data *", "action": "allow" },
        { "pattern": "sdd *--cwd*", "action": "deny" }
      ],
      "external_directory": "deny",
      "question": "deny",
      "skill": "deny"
    },
    "sdd-mcp-server": {
      "edit": "deny",
      "bash": "deny",
      "external_directory": "deny",
      "question": "deny",
      "skill": "deny"
    }
  },
  "post_write_feedback": true
}
